{
  "openapi": "3.0.3",
  "info": {
    "title": "FinShield Authorization Fixture Server",
    "description": "In-process fixture server for differential authorization and BOLA testing.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://authz.test"
    }
  ],
  "paths": {
    "/api/v1/objects/{id}": {
      "get": {
        "operationId": "getObject",
        "summary": "Fetch an object by ID with tenant isolation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Object retrieved successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/items": {
      "get": {
        "operationId": "getItems",
        "summary": "List items filtered by owner ID",
        "parameters": [
          {
            "name": "owner_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Items list retrieved successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/api/v1/paginated/{id}": {
      "get": {
        "operationId": "getPaginated",
        "summary": "Paginated resource catalog",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated catalog page"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  }
}
