{
  "openapi": "3.0.3",
  "info": {
    "title": "FinShield Authorization Fixture Server",
    "description": "In-process fixture server for differential authorization and BOLA testing.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://authz.test"
    }
  ],
  "paths": {
    "/api/v1/objects/{id}": {
      "get": {
        "operationId": "getObject",
        "summary": "Fetch an object by ID with tenant isolation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Object retrieved successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/items": {
      "get": {
        "operationId": "getItems",
        "summary": "List items filtered by owner ID",
        "parameters": [
          {
            "name": "owner_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Items list retrieved successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/api/v1/profile": {
      "get": {
        "operationId": "getProfile",
        "summary": "Caller-scoped profile",
        "responses": {
          "200": {"description": "Caller profile"},
          "401": {"description": "Unauthorized"}
        }
      }
    },
    "/api/v1/shared": {
      "get": {
        "operationId": "getShared",
        "summary": "Shared catalogue",
        "responses": {
          "200": {"description": "Shared catalogue"},
          "401": {"description": "Unauthorized"}
        }
      }
    },
    "/api/v1/paginated/{id}": {
      "get": {
        "operationId": "getPaginated",
        "summary": "Paginated resource catalog",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated catalog page"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/mutate/{id}": {
      "put": {
        "operationId": "mutateObject",
        "summary": "Mutation target for restore and verification tests",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {"description": "Mutation accepted"},
          "204": {"description": "Mutation accepted without a body"},
          "401": {"description": "Unauthorized"},
          "403": {"description": "Forbidden"},
          "404": {"description": "Not Found"}
        }
      }
    },
    "/api/v1/admin/report": {
      "get": {
        "operationId": "getAdminReport",
        "responses": {"200": {"description": "Admin report"}, "401": {"description": "Unauthorized"}, "403": {"description": "Forbidden"}, "404": {"description": "Not found"}}
      }
    },
    "/api/v1/admin/audit": {
      "get": {
        "operationId": "getAdminAudit",
        "responses": {"200": {"description": "Admin audit"}, "401": {"description": "Unauthorized"}, "403": {"description": "Forbidden"}}
      }
    },
    "/api/v1/admin/state": {
      "get": {
        "operationId": "getAdminState",
        "responses": {"200": {"description": "Admin state"}, "401": {"description": "Unauthorized"}}
      }
    },
    "/api/v1/admin/action": {
      "post": {
        "operationId": "adminAction",
        "responses": {"200": {"description": "Action accepted"}, "401": {"description": "Unauthorized"}, "403": {"description": "Forbidden"}}
      }
    },
    "/api/v1/login": {
      "post": {
        "operationId": "loginProbe",
        "summary": "Password probe target",
        "responses": {
          "200": {"description": "Login result"},
          "401": {"description": "Unauthorized"}
        }
      }
    }
  }
}
