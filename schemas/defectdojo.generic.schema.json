{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DefectDojo Generic Findings Import",
  "description": "Hand-written from DefectDojo Generic Findings Import documentation; verify against the deployed DefectDojo version.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["title", "description", "severity", "mitigation", "date", "cvssv3", "cwe", "unique_id_from_tool", "vuln_id_from_tool", "component_name", "endpoints", "active", "false_p"],
    "properties": {
      "title": {"type": "string", "minLength": 1},
      "description": {"type": "string", "minLength": 1},
      "severity": {"enum": ["Info", "Low", "Medium", "High", "Critical"]},
      "mitigation": {"type": "string", "minLength": 1},
      "date": {"type": "string", "format": "date"},
      "cvssv3": {"type": "string"},
      "cwe": {"type": "integer", "minimum": 1},
      "unique_id_from_tool": {"type": "string", "pattern": "^lp1:[0-9a-f]{64}$"},
      "vuln_id_from_tool": {"type": "string", "minLength": 1},
      "component_name": {"type": "string", "minLength": 1},
      "endpoints": {"type": "array", "items": {"type": "string", "pattern": "^/"}, "minItems": 1},
      "active": {"type": "boolean"},
      "false_p": {"type": "boolean"}
    }
  }
}
